{
  "name": "twi-ext",
  "version": "1.1.5",
  "description": "Unofficial utility to develop browser extensions for Twitter / X",
  "main": "dist/ts/index.js",
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "typedoc": "typedoc --plugin typedoc-plugin-markdown --cleanOutputDir --excludePrivate --includeVersion --readme none src/ts/index.ts",
    "format": "prettier ./src/ --write",
    "format:check": "prettier ./src/ --check",
    "lint": "eslint ./src/**/*.ts",
    "ci:version": "changeset version && npm run build && npm run typedoc && git add .",
    "ci:publish": "npm run build && changeset publish",
    "prepare": "ts-patch install && typia patch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/twi-ext.git"
  },
  "keywords": [
    "twitter",
    "extension",
    "web-extension",
    "browser-extension"
  ],
  "author": "Robot-Inventor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/twi-ext/issues"
  },
  "homepage": "https://github.com/Robot-Inventor/twi-ext#readme",
  "dependencies": {
    "@robot-inventor/ts-utils": "^0.8.0",
    "async-query": "^3.0.0",
    "typia": "^12.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/eslint-config": "^13.0.2",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-patch": "^4.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "zod-validation-error": "^5.0.0"
  }
}

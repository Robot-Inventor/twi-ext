{
  "name": "twi-ext",
  "version": "1.1.9",
  "description": "Unofficial utility to develop browser extensions for Twitter / X",
  "keywords": [
    "browser-extension",
    "extension",
    "twitter",
    "web-extension"
  ],
  "homepage": "https://github.com/Robot-Inventor/twi-ext#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/twi-ext/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/twi-ext.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/ts/index.js",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "typedoc": "typedoc --plugin typedoc-plugin-markdown --cleanOutputDir --excludePrivate --includeVersion --readme none src/ts/index.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ./src",
    "ci:version": "changeset version && npm run build && npm run typedoc && git add .",
    "ci:publish": "npm run build && changeset publish",
    "prepare": "ts-patch install && typia patch"
  },
  "dependencies": {
    "@robot-inventor/ts-utils": "^0.8.9",
    "async-query": "^3.0.5",
    "typia": "^12.2.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^1.2.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rimraf": "^6.1.3",
    "ts-patch": "^4.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3"
  }
}
